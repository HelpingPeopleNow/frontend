# Frontend env template. Copy to `frontend/.env` for standalone local dev
# (npm run dev / npm run build) — never edit this template with real values.
#
# When the frontend runs via docker compose, the VITE_* build args in
# infra/docker-compose.yml / docker-compose-dev.yaml take precedence and this
# file is not read at all.

# Umami analytics website ID (privacy-friendly analytics). Empty = disabled.
# VITE_UMAMI_WEBSITE_ID=

# Cap CAPTCHA public API endpoint, e.g. https://cap.helpingpeople.cloud/<site-id>.
# Empty = CAPTCHA disabled (dev default).
# VITE_CAP_API_ENDPOINT=
